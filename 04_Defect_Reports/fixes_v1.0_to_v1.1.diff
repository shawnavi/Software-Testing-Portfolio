diff -ru v1.0/java/com/team/expensetracker/BudgetManager.java v1.1/java/com/team/expensetracker/BudgetManager.java
--- v1.0/java/com/team/expensetracker/BudgetManager.java	2026-11-10 20:38:41
+++ v1.1/java/com/team/expensetracker/BudgetManager.java	2026-11-10 20:38:56
@@ -50,11 +50,13 @@
         if (!budgets.containsKey(key(category, month))) {
             return BudgetStatus.NO_BUDGET;
         }
-        BigDecimal percent = percentUsed(category, month);
-        if (percent.compareTo(FULL_PERCENT) >= 0) {
+        // Compare exact amounts. Using the rounded percentage made 799.99/1000 look like 80.00%.
+        BigDecimal limit = budgets.get(key(category, month));
+        BigDecimal spentTimes100 = spent(category, month).multiply(FULL_PERCENT);
+        if (spentTimes100.compareTo(limit.multiply(FULL_PERCENT)) > 0) {
             return BudgetStatus.EXCEEDED;
         }
-        if (percent.compareTo(WARNING_PERCENT) >= 0) {
+        if (spentTimes100.compareTo(limit.multiply(WARNING_PERCENT)) >= 0) {
             return BudgetStatus.WARNING;
         }
         return BudgetStatus.WITHIN;
